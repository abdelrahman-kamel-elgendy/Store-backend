# Runtime environment selected by ASP.NET Core.
ASPNETCORE_ENVIRONMENT=Development

# HTTP address. Change the port here to use another local port.
ASPNETCORE_URLS=http://localhost:5189

# SQL Server connection string; use a local development database.
ConnectionStrings__StoreDb=Server=localhost;Database=Store;Trusted_Connection=True;TrustServerCertificate=True

# Seed sample catalog data at startup only in Development. Set to true explicitly to enable.
SEED_DATABASE=false

# ASP.NET Core logging configuration.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Allowed host names; use a host-specific value in deployed environments.
AllowedHosts=localhost;127.0.0.1
